		On = function(Callback: (Value: ({
			["kind"]: (string),
			["payload"]: (string),
		})) -> ())
			table.insert(reliable_events[2], Callback)
			for _, value in reliable_event_queue[2] do
				task.spawn(Callback, value)
			end
			reliable_event_queue[2] = {}
			return function()
				table.remove(reliable_events[2], table.find(reliable_events[2], Callback))
			end
		end,
	},
	MiniSpawned = {
		On = function(Callback: (Value: ({
			["ownerUserId"]: (number),
			["slotIndex"]: (number),
			["heroId"]: (string),
			["payout"]: (number),
			["travelSec"]: (number),
		})) -> ())
			table.insert(reliable_events[4], Callback)
			for _, value in reliable_event_queue[4] do
				task.spawn(Callback, value)
			end
			reliable_event_queue[4] = {}
			return function()
				table.remove(reliable_events[4], table.find(reliable_events[4], Callback))
			end
		end,
	},
	BuyUpgrade = {
		Call = function(upgradeId: (string)): (({
			["success"]: (boolean),
			["error"]: ((string)?),
			["coins"]: ((number)?),
		}))
			function_call_id += 1
			function_call_id %= 256
			if reliable_event_queue[10][function_call_id] then
				function_call_id -= 1
				error("Zap has more than 256 calls awaiting a response, and therefore this packet has been dropped")
			end
			alloc(1)
			buffer.writeu8(outgoing_buff, outgoing_apos, 5)
			alloc(1)
			buffer.writeu8(outgoing_buff, outgoing_apos, function_call_id)
			local len_16 = #upgradeId
			assert(utf8.len(upgradeId) ~= nil, "value is not valid utf-8")
			alloc(2)
			buffer.writeu16(outgoing_buff, outgoing_apos, len_16)
			alloc(len_16)
			buffer.writestring(outgoing_buff, outgoing_apos, upgradeId, len_16)
			reliable_event_queue[10][function_call_id] = coroutine.running()
			return coroutine.yield()
		end,
	},
	BuyOfferIndex = {
		Call = function(offerIndex: (number)): (({
			["success"]: (boolean),
			["error"]: ((string)?),
		}))
			function_call_id += 1
			function_call_id %= 256
			if reliable_event_queue[7][function_call_id] then
				function_call_id -= 1
				error("Zap has more than 256 calls awaiting a response, and therefore this packet has been dropped")
			end
			alloc(1)
			buffer.writeu8(outgoing_buff, outgoing_apos, 2)
			alloc(1)
			buffer.writeu8(outgoing_buff, outgoing_apos, function_call_id)
			alloc(1)
			buffer.writeu8(outgoing_buff, outgoing_apos, offerIndex)
			reliable_event_queue[7][function_call_id] = coroutine.running()
			return coroutine.yield()
		end,
	},
}
type Events = typeof(returns)
return returns
