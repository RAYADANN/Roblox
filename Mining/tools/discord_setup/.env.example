# Create a bot at https://discord.com/developers/applications
# Bot → Reset Token → paste below
DISCORD_BOT_TOKEN=your_bot_token_here

# Server (Guild) ID: enable Developer Mode in Discord → right-click server → Copy Server ID
DISCORD_GUILD_ID=123456789012345678

# Set to 1 to re-run setup on a server that already has Zeon roles (may duplicate channels)
FORCE_SETUP=0
