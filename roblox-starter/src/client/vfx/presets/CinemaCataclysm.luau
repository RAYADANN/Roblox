type FlipOpts = {
	emitStyle: string?,
	sizeScale: number?,
	speedMin: number?,
	speedMax: number?,
	lifetimeMin: number?,
	lifetimeMax: number?,
	spread: number?,
	drag: number?,
	emitDuration: number?,
	lightEmission: number?,
	minTier: LayerDef.QualityTier?,
	sizeStart: number?,
	sizeMid: number?,
	sizeEnd: number?,
}

local function flip(at: number, tex: typeof(fire), count: number, opts: FlipOpts): LayerDef.LayerStep
	return {
		at = at,
		type = "Emit",
		count = count,
		texture = tex.id,
		flipbookLayout = tex.layout,
		flipbookMode = tex.mode,
		flipbookStartRandom = true,
		flipbookFpsMin = tex.fpsMin,
		flipbookFpsMax = tex.fpsMax,
		emitStyle = opts.emitStyle,
		sizeScale = opts.sizeScale,
		speedMin = opts.speedMin,
		speedMax = opts.speedMax,
		lifetimeMin = opts.lifetimeMin,
		lifetimeMax = opts.lifetimeMax,
		spread = opts.spread,
		drag = opts.drag,
		emitDuration = opts.emitDuration,
		lightEmission = opts.lightEmission,
		minTier = opts.minTier,
		sizeStart = opts.sizeStart,
		sizeMid = opts.sizeMid,
		sizeEnd = opts.sizeEnd,
	}
end

