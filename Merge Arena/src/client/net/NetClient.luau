end
local remotes = ReplicatedStorage:WaitForChild("ZAP")

local reliable = remotes:WaitForChild("ZAP_RELIABLE")
assert(reliable:IsA("RemoteEvent"), "Expected ZAP_RELIABLE to be a RemoteEvent")

local function SendEvents()
    if outgoing_used ~= 0 then
        local buff = buffer.create(outgoing_used)
        buffer.copy(buff, 0, outgoing_buff, 0, outgoing_used)

        reliable:FireServer(buff, outgoing_inst)

        outgoing_buff = buffer.create(64)
        outgoing_used = 0
        outgoing_size = 64
        table.clear(outgoing_inst)
    end
end

RunService.Heartbeat:Connect(SendEvents)

local reliable_events = table.create(4)
local reliable_event_queue: { [number]: { any } } = table.create(4)
local function_call_id = 0
reliable_events[0] = {}
reliable_event_queue[0] = {}
reliable_events[2] = {}
reliable_event_queue[2] = {}
reliable_events[1] = {}
reliable_event_queue[1] = {}
reliable_event_queue[3] = table.create(255)
reliable.OnClientEvent:Connect(function(buff, inst)
    incoming_buff = buff
    incoming_inst = inst
    incoming_read = 0
    incoming_ipos = 0
    local len = buffer.len(buff)
    while incoming_read < len do
        local id = buffer.readu8(buff, read(1))
        if id == 0 then -- PlayerDataSync
            local value
            value = {}
            value["coins"] = buffer.readf64(incoming_buff, read(8))
            value["rebirths"] = buffer.readu32(incoming_buff, read(4))
            value["pickaxe"] = buffer.readu32(incoming_buff, read(4))
            value["backpack"] = buffer.readu32(incoming_buff, read(4))
            if reliable_events[0][1] then
                for _, cb in reliable_events[0] do
                    task.spawn(cb, value)
                end
            else
                table.insert(reliable_event_queue[0], value)
                if #reliable_event_queue[0] > 64 then
                    warn(
                        `[ZAP] {#reliable_event_queue[0]} events in queue for PlayerDataSync. Did you forget to attach a listener?`
                    )
                end
            end
        elseif id == 2 then -- PlayVfx
            local value
            local bool_1 = buffer.readu8(incoming_buff, read(1))
            value = {}
            local len_1 = buffer.readu16(incoming_buff, read(2))
            value["effectId"] = buffer.readstring(incoming_buff, read(len_1), len_1)
            assert(utf8.len(value["effectId"]) ~= nil, "value is not valid utf-8")
            value["intensity"] = buffer.readf32(incoming_buff, read(4))
            if bit32.btest(bool_1, 0b0000000000000001) then
                value["pos"] = Vector3.new(
                    buffer.readf32(incoming_buff, read(4)),
                    buffer.readf32(incoming_buff, read(4)),
                    buffer.readf32(incoming_buff, read(4))
                )
            else
                value["pos"] = nil
            end
            if bit32.btest(bool_1, 0b0000000000000010) then
                value["from"] = Vector3.new(
                    buffer.readf32(incoming_buff, read(4)),
                    buffer.readf32(incoming_buff, read(4)),
                    buffer.readf32(incoming_buff, read(4))
                )
            else
                value["from"] = nil
            end
            if bit32.btest(bool_1, 0b0000000000000100) then
                value["to"] = Vector3.new(
                    buffer.readf32(incoming_buff, read(4)),
                    buffer.readf32(incoming_buff, read(4)),
                    buffer.readf32(incoming_buff, read(4))
                )
            else
                value["to"] = nil
            end
            if reliable_events[2][1] then
                for _, cb in reliable_events[2] do
                    task.spawn(cb, value)
                end
            else
                table.insert(reliable_event_queue[2], value)
                if #reliable_event_queue[2] > 64 then
                    warn(
                        `[ZAP] {#reliable_event_queue[2]} events in queue for PlayVfx. Did you forget to attach a listener?`
                    )
                end
            end
        elseif id == 1 then -- Notify
            local value
            value = {}
            local len_2 = buffer.readu16(incoming_buff, read(2))
            value["kind"] = buffer.readstring(incoming_buff, read(len_2), len_2)
            assert(utf8.len(value["kind"]) ~= nil, "value is not valid utf-8")
            local len_3 = buffer.readu16(incoming_buff, read(2))
            value["payload"] = buffer.readstring(incoming_buff, read(len_3), len_3)
            assert(utf8.len(value["payload"]) ~= nil, "value is not valid utf-8")
            if reliable_events[1][1] then
                for _, cb in reliable_events[1] do
                    task.spawn(cb, value)
                end
            else
                table.insert(reliable_event_queue[1], value)
                if #reliable_event_queue[1] > 64 then
                    warn(
                        `[ZAP] {#reliable_event_queue[1]} events in queue for Notify. Did you forget to attach a listener?`
                    )
                end
            end
        elseif id == 3 then -- BuyUpgrade
            local call_id = buffer.readu8(incoming_buff, read(1))
            local value
            local bool_2 = buffer.readu8(incoming_buff, read(1))
            value = {}
            value["success"] = bit32.btest(bool_2, 0b0000000000000001)
            if bit32.btest(bool_2, 0b0000000000000010) then
                local len_4 = buffer.readu16(incoming_buff, read(2))
                value["error"] = buffer.readstring(incoming_buff, read(len_4), len_4)
                assert(utf8.len(value["error"]) ~= nil, "value is not valid utf-8")
            else
                value["error"] = nil
            end
            if bit32.btest(bool_2, 0b0000000000000100) then
                value["coins"] = buffer.readf64(incoming_buff, read(8))
            else
                value["coins"] = nil
            end
            local thread = reliable_event_queue[3][call_id]
            -- When using actors it's possible for multiple Zap clients to exist, but only one called the Zap remote function.
            if thread then
                task.spawn(thread, value)
            end
            reliable_event_queue[3][call_id] = nil
        else
            error("Unknown event id")
        end
    end
end)
table.freeze(polling_queues_reliable)
table.freeze(polling_queues_unreliable)

local returns = {
