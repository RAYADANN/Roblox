			value["indexMaxTier"] = buffer.readu32(incoming_buff, read(4))
			value["productionLevel"] = buffer.readu32(incoming_buff, read(4))
			value["buyCount"] = buffer.readu32(incoming_buff, read(4))
			value["exclusiveOfferEndsAt"] = buffer.readu32(incoming_buff, read(4))
